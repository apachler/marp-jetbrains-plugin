<idea-plugin>
    <id>app.marp.jetbrains</id>
    <name>Marp for JetBrains</name>
    <vendor email="apachler@paan-systems.com" url="https://github.com/apachler">apachler</vendor>

    <description><![CDATA[
        <p>Live preview of <a href="https://marp.app">Marp</a> Markdown
        presentations inside JetBrains IDEs.</p>

        <h3>Features</h3>
        <ul>
            <li>Live preview of Marp Markdown in a split editor tab</li>
            <li>Hot-reload on edit</li>
            <li>Auto-install of Marp CLI (requires Node.js 18+)</li>
            <li>Configurable Node.js / Marp CLI paths</li>
        </ul>

        <h3>Requirements</h3>
        <ul>
            <li>Node.js 18 or newer installed on your system</li>
            <li>IntelliJ Platform 2024.3 or newer</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.intellij.plugins.markdown</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileEditorProvider
            implementation="app.marp.jetbrains.preview.MarpPreviewFileEditorProvider"/>
        <projectService
            serviceImplementation="app.marp.jetbrains.service.MarpProjectService"/>
        <projectService
            serviceImplementation="app.marp.jetbrains.cli.MarpServerManager"/>
        <applicationService
            serviceImplementation="app.marp.jetbrains.service.MarpApplicationService"/>
        <applicationService
            serviceImplementation="app.marp.jetbrains.settings.MarpSettings"/>
        <applicationConfigurable
            parentId="tools"
            instance="app.marp.jetbrains.settings.MarpSettingsConfigurable"
            id="app.marp.jetbrains.settings"
            displayName="Marp"/>
        <notificationGroup
            id="Marp"
            displayType="BALLOON"
            bundle="messages.MarpBundle"
            key="notification.group.name"/>
        <statusBarWidgetFactory
            id="Marp"
            order="last"
            implementation="app.marp.jetbrains.statusbar.MarpStatusBarWidgetFactory"/>
    </extensions>

    <actions>
        <group id="Marp.ToolsGroup"
               text="Marp"
               description="Marp preview actions"
               popup="true"
               icon="/META-INF/pluginIcon.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>

        <action id="Marp.OpenPreview"
                class="app.marp.jetbrains.actions.OpenMarpPreviewAction"
                text="Open Marp Preview"
                description="Open the Marp live preview for this Markdown file"/>
        <action id="Marp.ReloadPreview"
                class="app.marp.jetbrains.actions.ReloadMarpPreviewAction"
                text="Reload Marp Preview"
                description="Force-reload the Marp preview pane"/>

        <reference id="Marp.OpenPreview">
            <add-to-group group-id="Marp.ToolsGroup" anchor="first"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </reference>
        <reference id="Marp.ReloadPreview">
            <add-to-group group-id="Marp.ToolsGroup" anchor="after" relative-to-action="Marp.OpenPreview"/>
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="Marp.OpenPreview"/>
        </reference>
    </actions>
</idea-plugin>
