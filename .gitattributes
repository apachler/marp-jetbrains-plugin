# Normalize line endings so Windows checkouts don't corrupt scripts or trigger
# spurious diffs against contributors on Unix systems.
* text=auto eol=lf

# Shell scripts must stay LF even on Windows checkouts (Git Bash, WSL, CI).
*.sh        text eol=lf
gradlew     text eol=lf

# Windows-only files keep CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf
gradlew.bat text eol=crlf

# Treat these as binary so Git doesn't try to diff or normalise them.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.zip       binary
*.jar       binary

# Hide vendored / generated files from PR diff stats so review focuses on code.
gradle/wrapper/gradle-wrapper.jar binary linguist-vendored
